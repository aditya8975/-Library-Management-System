# ---------------------------------------------------------
# Database
# ---------------------------------------------------------
# Production (MySQL) — create the database first:
#   CREATE DATABASE library_db CHARACTER SET utf8mb4;
DATABASE_URL=mysql+pymysql://root:yourpassword@localhost:3306/library_db
#
# Quick local testing without MySQL installed — comment the
# line above and uncomment the line below to use a local
# SQLite file instead. All features work identically.
# DATABASE_URL=sqlite:///./library.db

# ---------------------------------------------------------
# Security
# ---------------------------------------------------------
# Generate a real secret with: openssl rand -hex 32
SECRET_KEY=replace-this-with-a-long-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---------------------------------------------------------
# Library business rules
# ---------------------------------------------------------
ISSUE_PERIOD_DAYS=14
FINE_PER_DAY=5.0

# ---------------------------------------------------------
# Default admin created automatically on first startup
# ---------------------------------------------------------
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=admin@library.local
DEFAULT_ADMIN_PASSWORD=Admin@123
